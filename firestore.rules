rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
    function isTenantMember() {
      return isSignedIn()
        && resource.data.tenantId != null
        && request.auth.token.tenantId != null
        && resource.data.tenantId == request.auth.token.tenantId;
    }
    function isTenantManager() {
      return isTenantMember() && request.auth.token.role == 'manager';
    }
    function isAdmin() {
      return isSignedIn() && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    // Proyectos solares 3D: propietario, miembro del tenant o administrador.
    // [AUD-2026 · B-05] Se eliminó la rama `|| resource.data.isPublic == true`, que quedaba
    // FUERA del bloque de autenticación y permitía lectura anónima de cualquier proyecto
    // marcado público. Ningún cliente escribe ese campo: era una puerta abierta sin uso.
    match /projects/{projectId} {
      allow read: if isOwner() || isTenantMember() || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if (isOwner() || isTenantManager() || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tenantId == resource.data.tenantId;

      allow delete: if isOwner() || isAdmin();
    }

    // Catálogos oficiales de equipos (módulos, inversores, estructuras, tarifas):
    // lectura universal, edición restringida a administradores.
    match /equipment_catalog/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Perfiles y preferencias de usuario
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
