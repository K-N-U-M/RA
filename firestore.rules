rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
    function isTenantMember() {
      return isSignedIn()
        && resource.data.tenantId != null
        && request.auth.token.tenantId != null
        && resource.data.tenantId == request.auth.token.tenantId;
    }
    function isTenantManager() {
      return isTenantMember() && request.auth.token.role == 'manager';
    }
    function isAdmin() {
      return isSignedIn() && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    // [F6-02] Validación de pertenencia de tenant y esquema básico en alta/edición
    function hasValidTenantOnWrite() {
      return !('tenantId' in request.resource.data)
        || request.resource.data.tenantId == null
        || (request.auth.token.tenantId != null && request.resource.data.tenantId == request.auth.token.tenantId);
    }
    function hasValidProjectSchema() {
      return request.resource.data.keys().hasAll(['ownerId', 'meta'])
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.meta is map
        && request.resource.data.meta.updatedAt is string
        && request.resource.data.keys().size() <= 80;
    }

    // Proyectos solares 3D: propietario, miembro del tenant o administrador.
    match /projects/{projectId} {
      allow read: if isOwner() || isTenantMember() || isAdmin();

      // [F6-02] Exige propietario autenticado, tenant válido y esquema íntegro (Firestore impide create sobre doc existente)
      allow create: if isSignedIn()
        && projectId.size() >= 8 && projectId.size() <= 128
        && request.resource.data.ownerId == request.auth.uid
        && hasValidTenantOnWrite()
        && hasValidProjectSchema();

      allow update: if (isOwner() || isTenantManager() || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('tenantId', null) == resource.data.get('tenantId', null)
        && hasValidProjectSchema();

      allow delete: if isOwner() || isAdmin();
    }

    // Catálogos oficiales de equipos (módulos, inversores, estructuras, tarifas):
    // lectura universal, edición restringida a administradores.
    match /equipment_catalog/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Perfiles y preferencias de usuario
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId && request.resource.data.keys().size() <= 40;
    }
  }
}
