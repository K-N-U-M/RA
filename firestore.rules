rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Proyectos solares 3D: solo el propietario, miembros del mismo tenant/organización o administradores
    match /projects/{projectId} {
      allow read: if (request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.tenantId != null && request.auth.token.tenantId != null && resource.data.tenantId == request.auth.token.tenantId) ||
        request.auth.token.role == 'admin'
      )) || resource.data.isPublic == true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.tenantId != null && request.auth.token.tenantId != null && resource.data.tenantId == request.auth.token.tenantId && request.auth.token.role == 'manager') ||
        request.auth.token.role == 'admin'
      );
    }

    // Catálogos oficiales de equipos (módulos, inversores, estructuras, tarifas):
    // Lectura universal, edición restringida a administradores o modo desarrollo
    match /equipment_catalog/{item} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    // Perfiles y preferencias de usuario
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
