rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    // [AUD-2026 · B-07] Validación de tipo y tamaño en toda escritura.
    function isValidUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'image/png'
            || request.resource.contentType == 'image/jpeg'
            || request.resource.contentType == 'image/webp'
            || request.resource.contentType == 'application/json');
    }

    // Proyectos (.raproject) y documentos PDF exportados (propietario o admin)
    match /projects/{userId}/{projectId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId && isValidUpload();
    }

    // Facturas y documentos de auditoría confidenciales
    match /audits/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId && isValidUpload();
    }

    // Logotipos corporativos y assets de marca.
    // [AUD-2026] La lectura deja de ser anónima (antes `if true` permitía enumerar logos).
    match /branding/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUpload();
    }
  }
}
