rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Proyectos (.raproject) y documentos PDF exportados
    match /projects/{userId}/{projectId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Facturas y documentos de auditoría confidenciales
    match /audits/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Logotipos corporativos y assets públicos de marca
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
