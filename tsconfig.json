{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ra/contracts": ["src/contracts/ra-contracts.d.ts"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "js/ra-event-bus.js",
    "js/ra-store.js",
    "js/ai-service.js",
    "js/wind/wasp-parser.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "functions/node_modules"
  ]
}
